# =============================================================
# Application Ports
# =============================================================
BE_PORT=3000
FE_PORT=3001

# =============================================================
# Database Configuration
# =============================================================
# Mặc định: SQLite (nếu để trống hoặc không điền, hệ thống tự fallback về file:./dev.db)
# Lưu ý: Khi chuyển sang PostgreSQL / MySQL, hãy cập nhật `provider` tương ứng trong apps/be/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Ví dụ cho PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_commerce?schema=public"

# Ví dụ cho MySQL:
# DATABASE_URL="mysql://root:password@localhost:3306/ai_commerce"

# =============================================================
# Frontend Configuration
# =============================================================
NUXT_PUBLIC_API_BASE=http://localhost:3000/api/v1

# =============================================================
# Environment
# =============================================================
NODE_ENV=development
