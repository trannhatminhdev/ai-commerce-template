{
  "name": "ai-commerce-template",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.22.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:be": "pnpm --filter be dev",
    "dev:fe": "pnpm --filter @ai-commerce/fe dev",
    "build": "turbo run build",
    "build:be": "pnpm --filter be build",
    "build:fe": "pnpm --filter @ai-commerce/fe build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter be prisma:generate",
    "db:migrate": "pnpm --filter be prisma:migrate",
    "db:studio": "pnpm --filter be prisma:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "turbo": "^2.0.0"
  }
}