{
  "name": "ai-commerce-template",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.22.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:be": "pnpm --filter be build",
    "build:fe": "pnpm --filter @ai-commerce/fe build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,vue}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "db:generate": "pnpm --filter be prisma:generate",
    "db:migrate": "pnpm --filter be prisma:migrate",
    "db:studio": "pnpm --filter be prisma:studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/fe/**/*.{ts,tsx,js,jsx,vue}": [
      "pnpm --filter @ai-commerce/fe exec eslint --fix",
      "prettier --write"
    ],
    "be/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter be exec eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.0.0"
  }
}
