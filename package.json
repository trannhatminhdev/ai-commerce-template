{
  "name": "ai-commerce-template",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.22.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:be": "pnpm --filter be build",
    "build:fe": "pnpm --filter @ai-commerce/fe build",
    "lint": "turbo run lint",
    "typecheck": "turbo typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.0.0"
  }
}
